<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer rules.

  android:allowBackup="false" already blocks this at every API level and
  android:fullBackupContent="false" covers API 23-30; this file is what API 31+
  reads instead. Declared so the intent survives any future decision to
  re-enable backup for something innocuous — these exclusions would still hold.

  What is kept out, and why:

    * The customer JWT. It now lives in flutter_secure_storage (Keystore), but
      the legacy plaintext copy in FlutterSharedPreferences is migrated only on
      the next loadToken(), so a backup taken before the customer reopens the
      app can still contain it. That token is 24h of full account access —
      order history, saved addresses, loyalty balance — with no server-side
      revocation.

    * FlutterSecureStorage's own keyset. Backing up the Keystore alias metadata
      next to the ciphertext is how "encrypted" storage ends up restored,
      intact and readable, on someone else's device.

  cloud-backup covers Google's automatic backup; device-transfer covers the
  direct phone-to-phone copy, which is a separate path and easy to forget.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
