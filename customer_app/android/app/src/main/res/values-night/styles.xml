<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is LIGHT-ONLY, so the OS dark-mode variants deliberately match
         values/styles.xml rather than going black. Left on Theme.Black, a phone
         with dark mode on flashed a black window before the first Flutter frame
         and kept a black window background behind the light UI. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/carevo_paper</item>
    </style>
</resources>
