# Copy to .env.local. Do NOT commit .env.local (see .gitignore).
#
# All three are REQUIRED — lib/config.ts throws at build time if any is unset.
# There are no defaults by design: each of these once had a hardcoded fallback
# pointing at the retired pos-1st-cut deployment and its database.
#
# NEXT_PUBLIC_* is inlined at BUILD time, so changing any of these needs a
# rebuild, not a restart.

# Local backend:
NEXT_PUBLIC_API_URL=http://localhost:8000
# Deployed backend:
# NEXT_PUBLIC_API_URL=https://gusto-pos-backend.onrender.com

# Outlet this build serves. Seeds the cart and drives the dev landing page at
# "/". Must be an outlet that exists in the database the backend above points
# at — an ID from another environment will look valid and quietly misroute.
NEXT_PUBLIC_OUTLET_ID=

# Default menu for fetchMenu(). That function currently has no callers; this is
# required only for consistency. See the note in lib/api.ts.
NEXT_PUBLIC_MENU_ID=
