<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GustoPOS.Views.SalesAndProfitPage"
             BackgroundColor="#F8F9FA">
    <Grid RowDefinitions="Auto,*" Padding="20,16,20,16">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackLayout Grid.Column="0" Spacing="2">
                <Label Text="Sales &amp; Profit" FontSize="22" FontAttributes="Bold" TextColor="#1B1B1B"/>
                <Label Text="Today's summary" TextColor="#6C757D" FontSize="13"/>
            </StackLayout>
            <Button Grid.Column="1"
                    Text="↻  Refresh"
                    Clicked="OnRefreshClicked"
                    BackgroundColor="#1B4332" TextColor="White"
                    CornerRadius="8" FontSize="13"
                    Padding="14,0" HeightRequest="36"
                    VerticalOptions="Center"/>
        </Grid>

        <!-- Scrollable body -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">

                <!-- Metric cards -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1" Stroke="#DEE2E6"
                            Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Total bills today" FontSize="13" TextColor="#6C757D"/>
                            <Label x:Name="LblTotalBills" Text="—"
                                   FontSize="32" FontAttributes="Bold" TextColor="#1B4332"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1" Stroke="#DEE2E6"
                            Padding="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Revenue today" FontSize="13" TextColor="#6C757D"/>
                            <Label x:Name="LblRevenue" Text="—"
                                   FontSize="32" FontAttributes="Bold" TextColor="#28A745"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Two-column detail grid -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                    <!-- Today's orders -->
                    <Border Grid.Column="0" BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1" Stroke="#DEE2E6"
                            Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Today's orders" FontSize="15" FontAttributes="Bold" TextColor="#1B1B1B"/>
                            <Grid ColumnDefinitions="56,52,*,36,64" Padding="4,0">
                                <Label Grid.Column="0" Text="Time"  FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="1" Text="Table" FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="2" Text="Dish"  FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="3" Text="Qty"   FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="4" Text="₹Price" FontSize="11" FontAttributes="Bold" TextColor="#6C757D" HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#DEE2E6"/>
                            <CollectionView x:Name="TimelineList" HeightRequest="380">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="56,52,*,36,64" Padding="4,5">
                                            <Label Grid.Column="0" Text="{Binding TimeStr}"  FontSize="12" TextColor="#495057"/>
                                            <Label Grid.Column="1" Text="{Binding TableId}"  FontSize="12" TextColor="#495057"/>
                                            <Label Grid.Column="2" Text="{Binding DishName}" FontSize="12" TextColor="#1B1B1B" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="3" Text="{Binding Quantity}" FontSize="12" TextColor="#495057"/>
                                            <Label Grid.Column="4" Text="{Binding PriceStr}" FontSize="12" TextColor="#1B4332" HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Summary -->
                    <Border Grid.Column="1" BackgroundColor="White"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1" Stroke="#DEE2E6"
                            Padding="12">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Summary" FontSize="15" FontAttributes="Bold" TextColor="#1B1B1B"/>
                            <Grid ColumnDefinitions="*,60,80" Padding="4,0">
                                <Label Grid.Column="0" Text="Dish"      FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="1" Text="Qty sold"  FontSize="11" FontAttributes="Bold" TextColor="#6C757D"/>
                                <Label Grid.Column="2" Text="₹Revenue"  FontSize="11" FontAttributes="Bold" TextColor="#6C757D" HorizontalTextAlignment="End"/>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#DEE2E6"/>
                            <CollectionView x:Name="AggregateList" HeightRequest="380">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,60,80" Padding="4,5">
                                            <Label Grid.Column="0" Text="{Binding DishName}"   FontSize="12" TextColor="#1B1B1B" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="1" Text="{Binding TotalQty}"   FontSize="12" TextColor="#495057"/>
                                            <Label Grid.Column="2" Text="{Binding RevenueStr}" FontSize="12" TextColor="#28A745" HorizontalTextAlignment="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentView>
