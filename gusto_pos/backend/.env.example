# Example environment for the Gusto POS backend.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Placeholders only below — no real secret belongs in this tracked file.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gusto_pos
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

PAYMENT_GATEWAY=stub

# Local testing dashboard (module: testing_dashboard).
# Shared secret sent as the X-Testing-Key header on every dashboard request.
# FAIL-CLOSED: while this is empty, every /api/v1/testing/* route returns 401.
# Set a real, long, random value here locally AND in Render's environment for
# the dashboard to work against a deployed backend.
TESTING_DASHBOARD_KEY=replace-with-a-long-random-secret
