# Example environment for the dashboard_app. Copy to `.env` locally, and set the
# real values as Render environment variables in production. NEVER commit `.env`
# or the real password/key — placeholders only in this tracked file.

# Login credentials, checked server-side (constant-time). The real values are
# set in Render, not written in this repo. Login FAILS while either is unset.
DASHBOARD_USER=set-in-render
DASHBOARD_PASS=set-in-render

# The main backend's TESTING_DASHBOARD_KEY. Held ONLY here; attached as the
# X-Testing-Key header when this app calls the backend. Never sent to browsers.
TESTING_DASHBOARD_KEY=set-in-render-must-match-backend

# Main backend root (no trailing /api/v1 — the app appends it).
BACKEND_URL=https://gusto-pos-backend.onrender.com

# Signs the session cookie. Use a long random value in production.
SESSION_SECRET=set-a-long-random-value
